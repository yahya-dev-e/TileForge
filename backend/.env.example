# Copy this file to `.env` (same folder) and fill in a real secret:
#   cp .env.example .env
#
# `.env` itself is gitignored — never commit real secrets. Generate one with:
#   openssl rand -hex 32
#
# Leave TILEFORGE_API_KEY unset (or delete .env) for local development: the
# /api/v1/generate-tile endpoint then requires no auth. Set it before exposing
# the server publicly (Brev, RunPod, ngrok, ...).
TILEFORGE_API_KEY=
